# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Isolated development data and test artifacts
.archive-local/
.archive-test/
.env.example.local
playwright-report/
test-results/

.archive-migration/

# Local numbered source backup copies
**/* [0-9].ts
**/* [0-9].tsx

# Private archive snapshots and isolated test datasets
/.archive-*/
